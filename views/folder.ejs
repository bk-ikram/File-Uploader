<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <% const actionBaseURL = locals.folderType === "subfolder" ? `/folder/${locals.currentFolderId}` : "/folder" %>
  <%- include('partials/navBar', {folderBreadcrumbs: folderBreadcrumbs, folderType: folderType}) %>
  <!-- Load errors, if any -->
  <%- include('partials/validation-errors') %>
  <h1><%= title %></h1>
  <% if (!locals.user) {%>
    <p>Please log in to access your files !</p>
  <% } else { %>
    <% if(locals.notification) {%>
      <p><%- locals.notification %></p>
    <% }; %>
    <h2>Folders</h2>
    <ul>
    <% if(locals.folders) { %>
        <% locals.folders.forEach( (f) => { %>
            <li>
              <a href="/folder/<%- f.id %>"><%- f.name %></a>
              <form method="post" action="/folder/<%- f.id %>/delete">
                <input name="parentFolderId" value="<%-locals.currentFolderId%>" type="hidden">
                <input name="parentfolderType" value="<%-locals.folderType%>" type="hidden">
                <button>Delete</button>
              </form>
            </li>
        <% });%>
    <% } %>
    </ul>
    <% if( locals.createFolder) { %>
      <!-- Add Folders -->
      <% const createURL = `${actionBaseURL}/create` %>
      <form action="<%- createURL %>" method="post">
        <h3>Create a New Folder</h3>
        <p>
          <label for="foldername">Name</label>
          <input type="text" id="foldername" name="foldername" required minlength="1" maxlength="30">
          <input name="parentFolderId" value="<%-locals.currentFolderId%>" type="hidden">
          <input name="folderType" value="<%-locals.folderType%>" type="hidden">
        </p>
        <button type="submit">Create</button>
   </form>
    <% } else { %>
        <a href="<%- actionBaseURL%>?createFolder=true">Create New Folder</a>
    <% }; %>
    <h2>Files</h2>
    <ul>
    <% if(locals.files) {%>
        <% locals.files.forEach( (f) => { %>
            <li><%- f.originalName %>
              <form method="post" action="/file/<%- f.id %>/delete">
                <input name="parentFolderId" value="<%-locals.currentFolderId%>" type="hidden">
                <input name="parentFolderType" value="<%-locals.folderType%>" type="hidden">
                <button>Delete</button>
              </form>
              <a href="/file/<%- f.id %>/download">Download</a>
            </li>
        <% });%>
    <% } %>
    </ul> 
    <% if( locals.uploadFile) { %>
      <!-- Add Folders -->
      <% const createURL = `${actionBaseURL}/upload` %>
      <form action="<%- createURL %>" method="post" enctype="multipart/form-data">
        <h3>Upload a File</h3>
        <p>
          <input name="folderId" value="<%-locals.currentFolderId%>" type="hidden">
                <input name="folderType" value="<%-locals.folderType%>" type="hidden">
          <label>File attachment here. Max size is 25 mb.</label>
          <input type="file" name="uploaded_file">
        </p>
        <button type="submit">Upload</button>
   </form>
    <% } else { %>
        <a href="<%- actionBaseURL%>?uploadFile=true">Upload a File</a>
    <% }; %>
  <% };%>
  
</body>
</html>