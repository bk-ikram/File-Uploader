<link rel="stylesheet" href="/styles/navbar.css">
<div class="navbar">
    <ul>
        <li><a href="/">Home</a></li>
        <% if (locals.user) {%>
            <li>&#128516;<%= locals.user.userName%></li>
            <li><a href="/logout">Logout</a></li>
        <%} else {%>
            <li><a href="/login">Login</a></li>
            <li><a href="/signup">Register</a></li>
        <% } %>
    </ul>
    <% if(locals.folderBreadcrumbs) {%>
        <p>
        <% locals.folderBreadcrumbs.map( (f, i) => { %>
            <% if(i !== 0) { %>
                <span>></span>
            <% }; %>
            <% if (locals.folderType === "mainfolder")  {%>
                <a href="/folder/"><%= f.name %></a>
            <%} else {%>
                <a href="/folder/<%= f.id %>"><%= f.name %></a>
            <% }; %>
        <% }); %>
        </p>
    <%};%>
</div>